# .env 예시
# 이 파일을 복사해 ".env"를 생성하고 값을 설정
# .env 는 .gitignore에 등록되어 업로드 되지 않음
# cp .env.example .env


# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=512

# Binwalk
BINWALK_SCAN_TIMEOUT_SECONDS=120
BINWALK_EXTRACT_TIMEOUT_SECONDS=1800

# Ghidra MCP (LaurieWired/GhidraMCP)
GHIDRA_MCP_URL=http://127.0.0.1:8081/sse
# Ghidra CodeBrowser에 현재 열어 둔 바이너리의 rootfs 내부 경로(선택)
# 예: /home/httpd/cgi-bin/timepro.cgi
GHIDRA_BINARY_PATH=

# QEMU MCP
QEMU_MCP_URL=http://127.0.0.1:8090/sse

# Target Firmware
TARGET_NAME=

# Demo Mode
# true : 도구 및 키가 없어도 파이프라인 전체를 데모 데이터를 사용해 끝까지 테스트
# false: 실제 binwalk/Ghidra/QEMU/LLM을 호출해 사용
DEMO_MODE=true

# Dynamic Analysis
# false: QEMU 단계를 건너뛰고 정적 분석 결과만 보고서로 생성
ENABLE_DYNAMIC_ANALYSIS=true
